# Project Streamline — environment variable reference
#
# Copy to .env and fill in values. Variables are read per Spring profile
# (backend) and by Vite at build time (frontend). The local and docker
# Spring profiles hardcode a local Postgres (postgres/postgres) and need
# none of these; the variables below are for the prod profile / real deploys.

# ---------------------------------------------------------------------------
# Backend (Spring Boot) — required when running the `prod` profile
# ---------------------------------------------------------------------------

# PostgreSQL connection (application-prod.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/streamline
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# Firebase Admin SDK — path to the service account JSON used to verify ID
# tokens (application.yml). Required. The file itself must NOT be committed.
GOOGLE_APPLICATION_CREDENTIALS=src/main/resources/serviceAccountKey.json

# Firebase project id (application.yml). Optional — defaults to the project's
# own id if unset.
FIREBASE_PROJECT_ID=your-firebase-project-id

# HTTP port the backend listens on (application.yml). Optional — defaults to 8080.
PORT=8080

# ---------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser, so never put secrets here
# ---------------------------------------------------------------------------

# Base URL of the backend API (frontend/src/api/http.ts). Optional — defaults
# to http://localhost:8080.
VITE_API_URL=http://localhost:8080

# NOTE: Firebase *web* config (apiKey, authDomain, etc.) is hardcoded in
# frontend/src/config/firebase.ts, not read from env. Firebase web API keys
# are public by design, so there is nothing secret to configure here.
